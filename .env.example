# ---- Anthropic ----
ANTHROPIC_API_KEY=

# ---- Database (agents VPS) ----
DATABASE_URL=postgres://hds:changeme@localhost:5432/hds_agents

# ---- HDS system endpoints (Phase 0 APIs) ----
INVENTORY_API_URL=https://inventory.hdstradingopc.com/api/v1
CRM_API_URL=https://crm.hdstradingopc.com/api/v1
ACCOUNTING_API_URL=https://accounting.hdstradingopc.com/api/v1
PAYROLL_API_URL=https://payroll.hdstradingopc.com/api/v1

# ---- Local stub (apps/stub-inventory), for running before Phase 0 ships ----
STUB_INVENTORY_PORT=4010
# ...then point the agents at it instead of the real system:
# INVENTORY_API_URL=http://127.0.0.1:4010/api/v1

# ---- One API key PER agent, scoped on the system side ----
AGENT_KEY_AUDITOR=
AGENT_KEY_INVENTORY_MANAGER=

# ---- Orchestrator ----
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_ADMIN_TOKEN=change-this-long-random-string

# ---- Approval gates (PHP) ----
INVENTORY_ADJUSTMENT_APPROVAL_THRESHOLD=5000
